# Copy to .env.local and fill in. Never commit the filled version -- this repo
# is public, and its contents are served by GitHub Pages.

# --- Supabase: required before the app can store anything --------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side only. The secret key bypasses row-level security entirely.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Project Settings -> Database -> Connection string -> Transaction pooler.
# Money is read through this (postgres.js keeps `numeric` as a string);
# PostgREST would turn it into a float and lose precision.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Scheduled jobs ----------------------------------------------------------
# Shared secret between the GitHub Actions EOD workflow and /api/cron/eod.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Optional providers ------------------------------------------------------
# Every one of these is optional. Absent means that source is unavailable, and
# the app shows "no data" rather than an invented number.
#
# Norges Bank (FX) and Firi (crypto) need NO key at all and are wired in first;
# together they price roughly 99% of the current portfolio.

# Portfolio-aware AI, research synthesis, screenshot import.
ANTHROPIC_API_KEY=

# Crypto fallback if Firi's public ticker is unavailable. Free demo tier.
COINGECKO_DEMO_KEY=

# Oslo Børs and global equities. The only reliable option is paid (~$20/mo);
# without it, OTOVO falls back to an unofficial source or to manual prices.
EODHD_API_KEY=
