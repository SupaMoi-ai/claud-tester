# Client-readable (Expo requires the EXPO_PUBLIC_ prefix to bundle these).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Server-only. Never prefix with EXPO_PUBLIC_ — must not end up in the app bundle.
# Used by supabase/seed/seed.ts (Node script) only.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the Supabase Edge Function (supabase/functions/analyze-capture).
# Set this as an Edge Function secret (`supabase secrets set ANTHROPIC_API_KEY=...`),
# not in this file's deployed equivalent.
ANTHROPIC_API_KEY=
